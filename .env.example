# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Meta WhatsApp Cloud API ──────────────────────────────
# From Meta App → WhatsApp → API setup. Never commit real values.
WHATSAPP_VERIFY_TOKEN=change-me-webhook-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=            # used to validate X-Hub-Signature-256 on inbound webhooks
WHATSAPP_GRAPH_VERSION=v21.0

# ─── Firebase (SOURCE OF TRUTH — same project as vcut-app) ─
# Path to the service-account JSON, OR inline the fields below.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
FIREBASE_PROJECT_ID=

# ─── AI (OpenAI) ──────────────────────────────────────────
# The model NEVER computes money — it only selects tools and phrases DB-read results.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Business rules (locked decisions, see PRD_REVIEW.md §11) ─
DEFAULT_INCENTIVE_RATE=0.10     # fallback ONLY; per-staff incentive_pct wins
LARGE_EXPENSE_APPROVAL_THRESHOLD=5000
